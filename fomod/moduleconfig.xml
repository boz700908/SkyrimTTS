<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>SkyrimNVDA</moduleName>
  <requiredInstallFiles>
    <folder source="SKSE" destination="SKSE"/>
    <folder source="Scripts" destination="Scripts"/>
    <folder source="Sound" destination="Sound"/>
    <file source="SkyrimTTS_AutoWalk.esp" destination="SkyrimTTS_AutoWalk.esp"/>
  </requiredInstallFiles>
  <installSteps>
    <installStep name="NVDA Controller">
      <optionalFileGroups>
        <group name="NVDAController" type="SelectAll">
          <plugins>
            <plugin name="NVDA Controller DLL (required)">
              <description>Installs nvdaControllerClient.dll to the game root folder. This file is required for the screen reader to work.</description>
              <files>
                <file source="Root\nvdaControllerClient.dll" destination="../../nvdaControllerClient.dll"/>
              </files>
              <typeDescriptor>
                <type name="Required"/>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
